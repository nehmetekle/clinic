# Copy this file to `.env` and fill in real values. `.env` is gitignored so
# secrets (e.g. a production database URL) are never committed.
# NEVER put a real password in THIS file — it is committed to git. Placeholders only.
#
# Postgres. In production this points at Neon:
#   DATABASE_URL — pooled (PgBouncer) connection, used at runtime.
#     postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true
#   DIRECT_URL   — unpooled connection, used only by `prisma migrate`.
#     postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
#
# For local dev, any local Postgres works (see README for a throwaway Docker
# container command).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public"

# The one real admin account, created by `npm run db:create-admin` — the only
# way a user gets into this database (there is no demo/seed data). Safe to
# re-run any time: it upserts by email, so it also works as a recovery path
# if this password is ever lost.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# WhatsApp appointment reminders (Meta Cloud API). Get these from
# developers.facebook.com → your app → WhatsApp → API Setup.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Optional: your approved production template names (default: hello_world).
# WHATSAPP_TEMPLATE_24H="appointment_reminder_24h"
# WHATSAPP_TEMPLATE_2H="appointment_reminder_2h"
# WHATSAPP_TEMPLATE_LANG="en_US"

# Protects the /api/cron/reminders endpoint. Set to a long random string; Vercel
# sends it automatically as a Bearer token on scheduled runs.
CRON_SECRET=""
