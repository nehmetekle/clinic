generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String             @id @default(cuid())
  fullName            String
  email               String             @unique
  username            String?            @unique
  passwordHash        String             @default("")
  role                String
  phone               String?
  status              String             @default("active")
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  supplements         String             @default("[]")
  consultationFee     Float?
  lastLoginAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  totpBackupCodes     String             @default("[]")
  totpEnabled         Boolean            @default(false)
  totpSecret          String?
  appointments        Appointment[]
  auditLogs           AuditLog[]
  bloodSamples        BloodSample[]
  assignedClients     Client[]           @relation("AssignedDietitian")
  createdClients      Client[]           @relation("CreatedByUser")
  consultations       Consultation[]
  expenses            Expense[]
  payments            Payment[]
  pendingTwoFactors   PendingTwoFactor[]
  sessions            Session[]
  visitBaskets        VisitBasket[]
}

model PendingTwoFactor {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  userAgent  String?
  ip         String?
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id                  String          @id @default(cuid())
  firstName           String
  lastName            String
  phone               String
  email               String?
  dateOfBirth         DateTime?
  gender              String?
  address             String?
  emergencyContact    String?
  medicalNotes        String?
  allergies           String?
  passportNumber      String?
  country             String?
  maritalStatus       String?
  referralSource      String?
  firstTimePatient    Boolean         @default(false)
  intakeComplete      Boolean         @default(true)
  registeredAt        DateTime        @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  assignedDietitianId String?
  createdById         String?
  referralFee         Float?
  appointments        Appointment[]
  bloodSamples        BloodSample[]
  assignedDietitian   User?           @relation("AssignedDietitian", fields: [assignedDietitianId], references: [id])
  createdBy           User?           @relation("CreatedByUser", fields: [createdById], references: [id])
  debts               ClientDebt[]
  packages            ClientPackage[]
  consultations       Consultation[]
  medicalHistory      MedicalHistory?
  payments            Payment[]
  sessionPlans        SessionPlan[]
  visitBaskets        VisitBasket[]
}

model SessionPlan {
  id             String                  @id @default(cuid())
  clientId       String
  machine        String?
  unitPrice      Float
  currency       String                  @default("USD")
  usdToLbp       Float                   @default(0)
  sessionsNeeded Int
  sessionsUsed   Int                     @default(0)
  sessionsPaid   Int                     @default(0)
  status         String                  @default("active")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  treatments     ConsultationTreatment[]
  client         Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  basketItems    VisitBasketItem[]
}

model MedicalHistory {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  conditions         String   @default("[]")
  intoleranceDetail  String?
  conditionsOther    String?
  hasAllergies       Boolean?
  allergiesDetail    String?
  takingMedications  Boolean?
  medicationsDetail  String?
  takingSupplements  Boolean?
  supplementsDetail  String?
  hadSurgeries       Boolean?
  surgeriesDetail    String?
  familyHistory      String   @default("[]")
  familyCancerDetail String?
  familyOther        String?
  drinksWater        Boolean?
  waterGlasses       String?
  drinksCaffeine     Boolean?
  drinksAlcohol      Boolean?
  alcoholFrequency   String?
  smokes             Boolean?
  cigarettesPerDay   String?
  exercises          Boolean?
  exerciseType       String?
  exerciseFrequency  String?
  sleepHours         String?
  wakesRested        Boolean?
  feelsStressed      Boolean?
  followsDiet        Boolean?
  snacksFrequently   Boolean?
  feelsFatigued      Boolean?
  moodSwings         Boolean?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Package {
  id              String          @id @default(cuid())
  name            String
  description     String?
  price           Float
  cost            Float           @default(0)
  currency        String          @default("USD")
  sessions        Int
  discountPercent Float           @default(0)
  status          String          @default("active")
  machine         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  clientPackages  ClientPackage[]
}

model ClientPackage {
  id            String                  @id @default(cuid())
  clientId      String
  packageId     String?
  packageName   String
  price         Float
  cost          Float                   @default(0)
  currency      String                  @default("USD")
  totalSessions Int
  usedSessions  Int                     @default(0)
  machine       String?
  startDate     DateTime                @default(now())
  status        String                  @default("active")
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  client        Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  package       Package?                @relation(fields: [packageId], references: [id])
  treatments    ConsultationTreatment[]
}

model Appointment {
  id          String    @id @default(cuid())
  clientId    String
  dietitianId String?
  date        DateTime
  time        String
  status      String    @default("scheduled")
  visitType   String    @default("follow_up")
  notes       String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dietitian   User?     @relation(fields: [dietitianId], references: [id])
}

model Consultation {
  id                    String                  @id @default(cuid())
  clientId              String
  dietitianId           String?
  date                  DateTime                @default(now())
  visitNumber           Int
  status                String                  @default("open")
  closedAt              DateTime?
  weightKg              Float?
  heightCm              Float?
  bmi                   Float?
  waistCm               Float?
  hipsCm                Float?
  bodyFatPercent        Float?
  muscleMassKg          Float?
  goalWeightKg          Float?
  clientGoals           String?
  notes                 String?
  recommendations       String?
  followUpPlan          String?
  bloodCollection       Boolean                 @default(false)
  bloodTests            String?
  bloodTestCharges      String?
  nurseRequired         Boolean                 @default(false)
  visitDiscountType     String?
  visitDiscountValue    Float                   @default(0)
  visitDiscountReason   String?
  visitDiscountCurrency String?
  visitServiceTotals    String?
  consultationFee       Float?
  consultationFeeWaived Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  bloodSample           BloodSample?
  debts                 ClientDebt[]
  client                Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dietitian             User?                   @relation(fields: [dietitianId], references: [id])
  products              ConsultationProduct[]
  treatments            ConsultationTreatment[]
  visitBaskets          VisitBasket[]
}

model ConsultationTreatment {
  id              String         @id @default(cuid())
  consultationId  String
  machine         String
  machineOther    String?
  bodyParts       String         @default("[]")
  sessionsNeeded  Int            @default(1)
  sessionsUsed    Int            @default(0)
  coveredSessions Int            @default(0)
  price           Float          @default(0)
  currency        String         @default("USD")
  clientPackageId String?
  sessionPlanId   String?
  notes           String?
  createdAt       DateTime       @default(now())
  clientPackage   ClientPackage? @relation(fields: [clientPackageId], references: [id])
  consultation    Consultation   @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  sessionPlan     SessionPlan?   @relation(fields: [sessionPlanId], references: [id])
}

model ServicePrice {
  id        String   @id @default(cuid())
  kind      String
  key       String
  name      String
  price     Float    @default(0)
  cost      Float    @default(0)
  currency  String   @default("USD")
  active    Boolean  @default(true)
  bodyParts String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([kind, key])
}

model Product {
  id        String   @id @default(cuid())
  name      String
  price     Float    @default(0)
  cost      Float    @default(0)
  currency  String   @default("USD")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ConsultationProduct {
  id             String       @id @default(cuid())
  consultationId String
  productId      String?
  name           String
  quantity       Int          @default(1)
  amount         Float        @default(0)
  unitPrice      Float        @default(0)
  currency       String       @default("USD")
  notes          String?
  createdAt      DateTime     @default(now())
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
}

model Payment {
  id               String       @id @default(cuid())
  clientId         String?
  motif            String
  amountPaid       Float
  currency         String       @default("USD")
  usdToLbp         Float        @default(0)
  method           String
  date             DateTime     @default(now())
  receiptNumber    String       @unique
  idempotencyKey   String?      @unique
  notes            String?
  createdById      String?
  createdAt        DateTime     @default(now())
  visitBasketId    String?
  client           Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy        User?        @relation(fields: [createdById], references: [id])
  settlementBasket VisitBasket? @relation("BasketPayments", fields: [visitBasketId], references: [id])
  visitBasket      VisitBasket? @relation("BasketPrimaryPayment")

  @@index([visitBasketId])
}

model VisitBasket {
  id                 String            @id @default(cuid())
  clientId           String
  dietitianId        String?
  consultationId     String?
  status             String            @default("pending")
  discountType       String?
  discountValue      Float             @default(0)
  discountReason     String?
  currency           String            @default("USD")
  usdToLbp           Float             @default(0)
  paymentId          String?           @unique
  sentAt             DateTime          @default(now())
  paidAt             DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  settlementPayments Payment[]         @relation("BasketPayments")
  client             Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consultation       Consultation?     @relation(fields: [consultationId], references: [id])
  dietitian          User?             @relation(fields: [dietitianId], references: [id])
  payment            Payment?          @relation("BasketPrimaryPayment", fields: [paymentId], references: [id])
  items              VisitBasketItem[]

  @@index([consultationId])
}

model VisitBasketItem {
  id            String       @id @default(cuid())
  basketId      String
  kind          String       @default("custom")
  label         String
  detail        String?
  quantity      Int          @default(1)
  unitPrice     Float        @default(0)
  currency      String       @default("USD")
  covered       Boolean      @default(false)
  sessionPlanId String?
  createdAt     DateTime     @default(now())
  basket        VisitBasket  @relation(fields: [basketId], references: [id], onDelete: Cascade)
  sessionPlan   SessionPlan? @relation(fields: [sessionPlanId], references: [id])
}

model ClientDebt {
  id             String        @id @default(cuid())
  clientId       String
  consultationId String?
  amount         Float
  currency       String        @default("USD")
  usdToLbp       Float         @default(0)
  reason         String
  source         String        @default("secretary_override")
  status         String        @default("outstanding")
  createdByName  String?
  clearedByName  String?
  clearedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consultation   Consultation? @relation(fields: [consultationId], references: [id])

  @@index([clientId])
  @@index([consultationId])
}

model BloodSample {
  id             String        @id @default(cuid())
  clientId       String
  dietitianId    String?
  dietitianName  String?
  consultationId String?       @unique
  tests          String        @default("[]")
  orderedAt      DateTime      @default(now())
  sentAt         DateTime?
  receivedAt     DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  dietitian      User?         @relation(fields: [dietitianId], references: [id])

  @@index([sentAt])
  @@index([receivedAt])
}

model Expense {
  id           String   @id @default(cuid())
  title        String
  amount       Float
  currency     String   @default("USD")
  usdToLbp     Float    @default(0)
  date         DateTime @default(now())
  paidBy       String?
  method       String?
  notes        String?
  amountEdited Boolean  @default(false)
  createdById  String?
  createdAt    DateTime @default(now())
  createdBy    User?    @relation(fields: [createdById], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String
  action      String
  entityType  String
  entityLabel String
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model Referrer {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  fee       Float    @default(0)
}

model Counter {
  key   String @id
  value Int    @default(0)
}
