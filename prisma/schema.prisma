generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String             @id @default(cuid())
  fullName            String
  email               String             @unique
  username            String?            @unique
  passwordHash        String             @default("")
  role                String
  phone               String?
  status              String             @default("active")
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  supplements         String             @default("[]")
  consultationFee     Float?
  lastLoginAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  totpBackupCodes     String             @default("[]")
  totpEnabled         Boolean            @default(false)
  totpSecret          String?
  appointments        Appointment[]
  auditLogs           AuditLog[]
  fxRateChanges       FxRateChange[]
  bloodSamples        BloodSample[]
  bloodSampleFiles    BloodSampleFile[]
  assignedClients     Client[]           @relation("AssignedDietitian")
  createdClients      Client[]           @relation("CreatedByUser")
  consultations       Consultation[]
  consultationFiles   ConsultationFile[]
  expenses            Expense[]
  jessySettlements    JessySettlement[]
  referralPayouts     ReferralPayout[]
  payments            Payment[]
  pendingTwoFactors   PendingTwoFactor[]
  sessions            Session[]
  visitBaskets        VisitBasket[]
  machineVisits       MachineVisit[]     @relation("MachineVisitRecordedBy")
  voidedMachineVisits MachineVisit[]     @relation("MachineVisitVoidedBy")
}

model PendingTwoFactor {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  userAgent  String?
  ip         String?
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id                  String            @id @default(cuid())
  firstName           String
  lastName            String
  phone               String
  email               String?
  dateOfBirth         DateTime?
  gender              String?
  address             String?
  emergencyContact    String?
  medicalNotes        String?
  allergies           String?
  passportNumber      String?
  country             String?
  maritalStatus       String?
  /// The referrer as the front desk currently believes it — EDITABLE (a check-in
  /// or profile correction rewrites it). Because it is mutable it must never be
  /// the key a financial figure is grouped by; use `referrerNameSnapshot` for
  /// that. Kept as the live display value and the input to `resolveReferralFee`
  /// at registration.
  referralSource      String?
  /// The referrer this patient is ATTRIBUTED to. Follows `referralSource` on
  /// every edit (registration, check-in correction, or adding one after the
  /// fact) right up until a `ReferralCommission` row exists for this client —
  /// then it freezes, because that row is what was actually incurred/paid
  /// against and no later edit may redirect it. This is the identity half of the
  /// referral model; the AMOUNT is not stored here — it is resolved from the
  /// referrer's live rate at the moment the commission is incurred (the first
  /// completed visit) and frozen onto the ReferralCommission row then.
  referrerNameSnapshot String?
  /// Precise link to the Referrer row the fee was resolved from, for the cases a
  /// name cannot disambiguate (two referrers, one renamed into the other's old
  /// name). Nulls out if that referrer is later deleted, which is exactly why the
  /// NAME is snapshotted separately and is the durable field.
  referrerId          String?
  firstTimePatient    Boolean           @default(false)
  intakeComplete      Boolean           @default(true)
  registeredAt        DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  assignedDietitianId String?
  createdById         String?
  // Whether this patient gets WhatsApp appointment reminders. Default on; staff
  // can opt a patient out (see consent checkbox at registration/check-in).
  whatsappOptIn       Boolean           @default(true)
  appointments        Appointment[]
  bloodSamples        BloodSample[]
  assignedDietitian   User?             @relation("AssignedDietitian", fields: [assignedDietitianId], references: [id])
  referrer            Referrer?         @relation(fields: [referrerId], references: [id], onDelete: SetNull)
  referralCommission  ReferralCommission?
  createdBy           User?             @relation("CreatedByUser", fields: [createdById], references: [id])
  debts               ClientDebt[]
  packages            ClientPackage[]
  consultations       Consultation[]
  jessyReceivables    JessyReceivable[]
  medicalHistory      MedicalHistory?
  payments            Payment[]
  sessionPlans        SessionPlan[]
  visitBaskets        VisitBasket[]
  machineVisits       MachineVisit[]
}

model SessionPlan {
  id                String                  @id @default(cuid())
  clientId          String
  machine           String?
  unitPrice         Float
  /// The clinic's OWN per-session cost, frozen from ServicePrice.cost when this
  /// plan was created. Admin-only and never serialized to a client. Frozen for
  /// the same reason `unitPrice` is: a later catalog cost edit must not rewrite
  /// the margin of sessions already sold and delivered. 0 on rows created before
  /// cost capture existed — see the reporting cutover in docs/known-issues.md.
  unitCost          Float                   @default(0)
  currency          String                  @default("USD")
  usdToLbp          Float                   @default(0)
  sessionsNeeded    Int
  sessionsUsed      Int                     @default(0)
  sessionsPaid      Int                     @default(0)
  status            String                  @default("active")
  // Mirror of `machine` that is only set while the plan is ACTIVE (null otherwise).
  // With the unique index below this is what enforces "one active session plan per
  // client per machine" in the DATABASE, not just in the UI: Postgres treats NULLs
  // as distinct, so any number of completed/cancelled plans may coexist. Always set
  // through `activeMachineKey()` in repositories/sessionPlans.ts — never by hand.
  activeMachineKey  String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  treatments        ConsultationTreatment[]
  client            Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  basketItems       VisitBasketItem[]
  machineVisitItems MachineVisitItem[]

  @@unique([clientId, activeMachineKey])
}

model MedicalHistory {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  conditions         String   @default("[]")
  intoleranceDetail  String?
  conditionsOther    String?
  medicalHistoryNote String?
  hasAllergies       Boolean?
  allergiesDetail    String?
  takingMedications  Boolean?
  medicationsDetail  String?
  takingSupplements  Boolean?
  supplementsDetail  String?
  hadSurgeries       Boolean?
  surgeriesDetail    String?
  familyHistory      String   @default("[]")
  familyCancerDetail String?
  familyOther        String?
  familyHistoryNote  String?
  drinksWater        Boolean?
  waterGlasses       String?
  drinksCaffeine     Boolean?
  drinksAlcohol      Boolean?
  alcoholFrequency   String?
  smokes             Boolean?
  cigarettesPerDay   String?
  exercises          Boolean?
  exerciseType       String?
  exerciseFrequency  String?
  sleepHours         String?
  wakesRested        Boolean?
  feelsStressed      Boolean?
  followsDiet        Boolean?
  snacksFrequently   Boolean?
  feelsFatigued      Boolean?
  moodSwings         Boolean?
  lifestyleNotes     String   @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Package {
  id              String          @id @default(cuid())
  name            String
  description     String?
  price           Float
  cost            Float           @default(0)
  currency        String          @default("USD")
  sessions        Int
  discountPercent Float           @default(0)
  status          String          @default("active")
  machine         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  clientPackages  ClientPackage[]
}

model ClientPackage {
  id                String                  @id @default(cuid())
  clientId          String
  packageId         String?
  packageName       String
  price             Float
  cost              Float                   @default(0)
  currency          String                  @default("USD")
  totalSessions     Int
  usedSessions      Int                     @default(0)
  machine           String?
  startDate         DateTime                @default(now())
  status            String                  @default("active")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  client            Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  package           Package?                @relation(fields: [packageId], references: [id])
  treatments        ConsultationTreatment[]
  machineVisitItems MachineVisitItem[]
  basketItems       VisitBasketItem[]
}

model Appointment {
  id                String         @id @default(cuid())
  clientId          String
  dietitianId       String?
  date              DateTime
  time              String
  status            String         @default("scheduled")
  visitType         String         @default("follow_up")
  notes             String?
  completedAt       DateTime?
  // WhatsApp reminder tracking — each set once its reminder is sent, so a patient
  // never gets the same reminder twice. Two independent reminders per visit:
  // ~24h before, and ~1–2h before.
  reminder24hSentAt DateTime?
  reminder2hSentAt  DateTime?
  // Mirror of `clientId|dietitianId|date|time`, set only while the booking is
  // ACTIVE (scheduled/checked_in/with_dietitian) and only when a dietitian is
  // assigned — null otherwise. With the unique index below this is what makes
  // "the same client can't be booked twice with the same dietitian at the same
  // time" impossible in the DATABASE, not just the UI: Postgres treats NULLs as
  // distinct, so completed/cancelled/no-show rows and unassigned bookings are
  // unconstrained. Always set through `activeSlotKey()` in
  // repositories/appointments.ts — never by hand.
  activeSlotKey     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dietitian         User?          @relation(fields: [dietitianId], references: [id])
  machineVisits     MachineVisit[]
  consultations     Consultation[]

  @@unique([activeSlotKey])
}

model Consultation {
  id                    String                  @id @default(cuid())
  clientId              String
  dietitianId           String?
  /// The appointment this visit is fulfilling, when it was started from one.
  /// Closing the visit completes THIS booking and no other — a patient with two
  /// bookings on the board must not have both closed out by one visit. Null for a
  /// walk-in or a visit started outside the queue flow; the close then falls back
  /// to completing a single unambiguous live appointment (see
  /// completeLinkedAppointmentTx).
  appointmentId         String?
  date                  DateTime                @default(now())
  visitNumber           Int
  status                String                  @default("open")
  closedAt              DateTime?
  weightKg              Float?
  heightCm              Float?
  bmi                   Float?
  waistCm               Float?
  hipsCm                Float?
  bodyFatPercent        Float?
  muscleMassKg          Float?
  goalWeightKg          Float?
  clientGoals           String?
  notes                 String?
  recommendations       String?
  followUpPlan          String?
  bloodCollection       Boolean                 @default(false)
  bloodTests            String?
  /// JSON array of the blood tests charged on this visit, each snapshotted from
  /// the catalog at save time: `{ name, price, currency, cost }`. `cost` is the
  /// clinic's own frozen cost and is ADMIN-ONLY — `parseCharges` strips it when
  /// building the client-facing type, so it never leaves the server outside a
  /// report. Rows written before cost capture have no `cost` key (treat as
  /// unknown, not as zero).
  bloodTestCharges      String?
  nurseRequired         Boolean                 @default(false)
  visitDiscountType     String?
  visitDiscountValue    Float                   @default(0)
  visitDiscountReason   String?
  visitDiscountCurrency String?
  visitServiceTotals    String?
  consultationFee       Float?
  consultationFeeWaived Boolean                 @default(false)
  /// The dietitian's name frozen at the moment the visit closed. A closed visit
  /// is a historical record: renaming the staff member later must not rewrite it.
  /// Null while the visit is open (read the live relation then) and on visits
  /// closed before this column existed.
  dietitianNameSnapshot String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  bloodSample           BloodSample?
  debts                 ClientDebt[]
  client                Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dietitian             User?                   @relation(fields: [dietitianId], references: [id])
  appointment           Appointment?            @relation(fields: [appointmentId], references: [id])
  files                 ConsultationFile[]
  foodList              ConsultationFoodList?
  jessyReceivables      JessyReceivable[]
  products              ConsultationProduct[]
  treatments            ConsultationTreatment[]
  visitBaskets          VisitBasket[]

  @@index([appointmentId])
}

// The "Nutrient-Rich Foods List" the dietitian fills in during a visit — the web
// version of Layaka's paper form, used to assess what the patient actually eats.
// One per consultation (optional: most visits never open it), so a 1–1 relation
// rather than more JSON columns on Consultation.
//
// `selections` is a JSON array of stable catalog ids ("vegetables.artichoke"),
// matching how Consultation.bloodTests stores its list. Ids — not labels — so
// re-wording an item in the catalog never orphans a saved tick. Unknown ids are
// ignored on read, which keeps an old record readable if an item is ever retired.
//
// `language` exists so the Arabic edition of the same form (out of scope for now,
// the button is present but disabled) drops in without a migration.
model ConsultationFoodList {
  id             String       @id @default(cuid())
  consultationId String       @unique
  language       String       @default("en")
  patientName    String
  notes          String?
  selections     String       @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
}

// A file attached to a consultation — today the generated Food List PDF. Mirrors
// BloodSampleFile exactly (bytes inline in Postgres, `data` never selected for
// listings, frozen `uploadedByName` attribution) so both attachment kinds behave
// the same way; see that model's comment for the reasoning behind inline bytes.
//
// Unlike a blood-test result, the finished PDF is NOT clinical-restricted: every
// role may download it (the doctor fills the form in, the front desk hands the
// printout to the patient). `kind` tags what produced the file so the profile's
// Files tab can filter by it.
model ConsultationFile {
  id             String       @id @default(cuid())
  consultationId String
  kind           String       @default("food-list")
  filename       String
  mimeType       String
  size           Int
  data           Bytes
  uploadedById   String?
  uploadedByName String
  createdAt      DateTime     @default(now())
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id])

  // One current file per visit per kind, enforced by the database rather than by
  // application timing: the manual "Generate PDF" button and the automatic
  // catch-up at close can fire at the same moment, and a find-then-create pair
  // lets both inserts through. `saveConsultationFile` upserts against this key,
  // so a regenerate replaces the row in place instead of stacking near-identical
  // sheets the front desk would have to choose between.
  @@unique([consultationId, kind])
  @@index([consultationId])
}

model ConsultationTreatment {
  id                  String         @id @default(cuid())
  consultationId      String
  /// The machine this treatment was delivered on: a KEY FROM THE TREATMENT
  /// CATALOG (ServicePrice, kind "treatment"), never free text.
  ///
  /// There is deliberately no "Other"/custom machine. A machine is one of the
  /// clinic's predefined machines or it is nothing — the old `machineOther`
  /// free-text escape hatch is gone, because it gave the SAME physical machine
  /// two identities (the catalog key on one path, the typed label on another) and
  /// split it into two rows in every report that grouped by machine.
  machine             String
  bodyParts           String         @default("[]")
  sessionsNeeded      Int            @default(1)
  sessionsUsed        Int            @default(0)
  coveredSessions     Int            @default(0)
  price               Float          @default(0)
  /// Per-session (or per-treatment) clinic cost, frozen at the moment this line
  /// was first written, from ServicePrice.cost — or from the session plan's own
  /// frozen `unitCost` for a plan-backed line. Admin-only; never serialized.
  /// Preserved verbatim across draft edits, exactly like `price`.
  unitCost            Float          @default(0)
  currency            String         @default("USD")
  clientPackageId     String?
  sessionPlanId       String?
  notes               String?
  /// The bundle's name frozen at visit close, for the same reason as
  /// Consultation.dietitianNameSnapshot. `ClientPackage.packageName` is already a
  /// purchase-time snapshot, but it is reached through a nullable relation that a
  /// deleted bundle would sever — this keeps the label on the visit itself.
  packageNameSnapshot String?
  createdAt           DateTime       @default(now())
  clientPackage       ClientPackage? @relation(fields: [clientPackageId], references: [id])
  consultation        Consultation   @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  sessionPlan         SessionPlan?   @relation(fields: [sessionPlanId], references: [id])
}

model ServicePrice {
  id        String   @id @default(cuid())
  kind      String
  key       String
  name      String
  price     Float    @default(0)
  cost      Float    @default(0)
  currency  String   @default("USD")
  active    Boolean  @default(true)
  bodyParts String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([kind, key])
}

model Product {
  id                String   @id @default(cuid())
  name              String
  price             Float    @default(0)
  cost              Float    @default(0)
  currency          String   @default("USD")
  active            Boolean  @default(true)
  // Current on-hand quantity. Only ever changed through an audited adjustment
  // (sale/restock/correction) — never a raw overwrite — so AuditLog stays the
  // complete history of how it got here. May go negative (oversold); the app
  // shows that as a backorder flag rather than blocking the sale.
  stock             Int      @default(0)
  // Admin-set reorder point for this specific product (differs a lot by item —
  // a bulk supplement vs. a rarely-stocked one). stock <= this triggers the
  // low-stock notification/badge.
  lowStockThreshold Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
}

model ConsultationProduct {
  id             String       @id @default(cuid())
  consultationId String
  productId      String?
  name           String
  quantity       Int          @default(1)
  amount         Float        @default(0)
  unitPrice      Float        @default(0)
  /// Per-unit clinic cost frozen at the moment of sale from Product.cost, the
  /// exact counterpart of `unitPrice`. COGS for this line is unitCost × quantity.
  /// Admin-only; never serialized to a client.
  unitCost       Float        @default(0)
  currency       String       @default("USD")
  notes          String?
  createdAt      DateTime     @default(now())
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
}

model Payment {
  id                  String           @id @default(cuid())
  clientId            String?
  motif               String
  // NATIVE amount, in `currency` — what the patient physically handed over. It is
  // never normalised to USD at write time: the USD value is derived from this and
  // `fxRate`, so both the tender and the accounting figure survive forever.
  amountPaid          Float
  // Tender currency: USD, EUR or LBP. Constrained by a CHECK in the
  // multi_currency_tender migration (Prisma cannot express it), so an unsupported
  // currency cannot exist in the table even if a code path were to slip.
  currency            String           @default("USD")
  usdToLbp            Float            @default(0)
  // Units of `currency` per 1 USD, FROZEN when this payment was recorded:
  // amountPaid / fxRate is its USD value, forever. Reports must use this and
  // never today's Settings, so changing a rate cannot re-price history.
  // Null only on rows written before multi-currency tender (USD or LBP, where
  // `usdToLbp` carries exactly the same meaning — see frozenPaymentFxRate).
  fxRate              Float?
  method              String
  date                DateTime         @default(now())
  receiptNumber       String           @unique
  idempotencyKey      String?          @unique
  notes               String?
  createdById         String?
  createdAt           DateTime         @default(now())
  visitBasketId       String?
  // Portion of `amountPaid` that is the card-payment surcharge fee (Setting
  // "cardSurchargePercent"), not the underlying charge — 0 for every non-card
  // payment and for card payments made before/without this fee configured.
  // Frozen at creation like `usdToLbp`, so a later rate change never reprices
  // history. Original amount = amountPaid - cardSurchargeAmount.
  cardSurchargeAmount Float            @default(0)
  client              Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy           User?            @relation(fields: [createdById], references: [id])
  settlementBasket    VisitBasket?     @relation("BasketPayments", fields: [visitBasketId], references: [id])
  visitBasket         VisitBasket?     @relation("BasketPrimaryPayment")
  // Present only on a `jessy` payment: the matching amount Jessy still owes the
  // clinic. Created in the SAME write as the payment (a nested create), so a
  // jessy payment can never exist without its receivable, or vice versa.
  jessyReceivable     JessyReceivable?

  @@index([visitBasketId])
}

// ---- Jessy (third-party payer) receivables ----
// The patient pays through Jessy: that money is real income the moment the visit
// is settled (a normal Payment row with method "jessy", counted in every
// payment-method breakdown). What this table tracks is the SEPARATE obligation
// that Jessy now owes the clinic that amount. It is deliberately NOT a
// ClientDebt — the patient owes nothing for the Jessy portion.
model JessyReceivable {
  id             String                      @id @default(cuid())
  // One receivable per payment, DB-enforced: a double-submitted jessy payment
  // resolves to the same Payment row (idempotencyKey) and therefore can never
  // stack a second receivable.
  paymentId      String                      @unique
  clientId       String?
  consultationId String?
  // USD, converted at the rate FROZEN on the source payment. The native
  // amount/currency stays on that Payment, so nothing is lost; keeping the
  // ledger in one currency is what lets settlement allocate safely.
  amount         Float
  // Still owed by Jessy on this receivable (USD). Decremented by settlement
  // allocations under a `gte` guard, so it can never go below zero.
  remaining      Float
  status         String                      @default("outstanding")
  createdByName  String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  payment        Payment                     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  client         Client?                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consultation   Consultation?               @relation(fields: [consultationId], references: [id])
  allocations    JessySettlementAllocation[]

  @@index([status, createdAt])
  @@index([clientId])
}

// One transfer of money actually received FROM Jessy. Records no Payment and no
// income — the income was already recognized when the patients paid through
// Jessy; this only draws down the receivables below.
model JessySettlement {
  id             String                      @id @default(cuid())
  amount         Float // USD received in this transfer
  reference      String?
  notes          String?
  idempotencyKey String?                     @unique
  recordedById   String?
  recordedByName String?
  createdAt      DateTime                    @default(now())
  recordedBy     User?                       @relation(fields: [recordedById], references: [id])
  allocations    JessySettlementAllocation[]
}

// How one transfer was applied across receivables (oldest first). This is what
// makes a partial settlement auditable down to the originating visit.
model JessySettlementAllocation {
  id           String          @id @default(cuid())
  settlementId String
  receivableId String
  amount       Float
  createdAt    DateTime        @default(now())
  settlement   JessySettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  receivable   JessyReceivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@index([receivableId])
}

model VisitBasket {
  id                 String            @id @default(cuid())
  clientId           String
  dietitianId        String?
  consultationId     String?
  status             String            @default("pending")
  discountType       String?
  discountValue      Float             @default(0)
  discountReason     String?
  currency           String            @default("USD")
  usdToLbp           Float             @default(0)
  paymentId          String?           @unique
  sentAt             DateTime          @default(now())
  paidAt             DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  settlementPayments Payment[]         @relation("BasketPayments")
  client             Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consultation       Consultation?     @relation(fields: [consultationId], references: [id])
  dietitian          User?             @relation(fields: [dietitianId], references: [id])
  payment            Payment?          @relation("BasketPrimaryPayment", fields: [paymentId], references: [id])
  items              VisitBasketItem[]
  // Set only on the basket a MACHINE VISIT raised for sessions its client had not
  // prepaid. Mutually exclusive with `consultationId` in practice: a basket belongs
  // to one visit event or the other, never both. Voiding an unsettled machine visit
  // deletes this basket; a settled one blocks the void outright.
  machineVisitId     String?
  machineVisit       MachineVisit?     @relation(fields: [machineVisitId], references: [id])

  @@index([consultationId])
  @@index([machineVisitId])
}

model VisitBasketItem {
  id            String       @id @default(cuid())
  basketId      String
  kind          String       @default("custom")
  label         String
  detail        String?
  quantity      Int          @default(1)
  unitPrice     Float        @default(0)
  currency      String       @default("USD")
  covered       Boolean      @default(false)
  /// The clinic's own cost for this line, per unit, FROZEN when the line was
  /// built — the cost counterpart of `unitPrice`. COGS for the line is
  /// `unitCost * quantity`. 0 for lines that have no cost of goods (a
  /// consultation fee is the doctor's time, which is an operating expense).
  /// Admin-only: never serialized to a client.
  unitCost      Float        @default(0)
  /// The line's allocated share of the bill-level discount, in the basket's
  /// currency, FROZEN at settlement.
  ///
  /// A discount is NOT a price edit. `unitPrice` stays exactly what the item cost
  /// according to its source, forever and auditably; the reduction lives here,
  /// separately. The line's actual sale amount is
  /// `unitPrice * quantity - discountAmount`, and the allocation is computed so
  /// these sum EXACTLY to the amount charged to the client — no residual cent can
  /// appear between the sum of the lines and the basket total.
  discountAmount Float       @default(0)
  sessionPlanId String?
  // Permanent catalog reference for a "product" line (survives rename/delete,
  // like ConsultationProduct.productId) — lets settlement deduct inventory by
  // the exact final quantity sitting in the basket. Null for non-product lines.
  productId     String?
  /// The prepaid bundle this line SELLS. Without it a bundle line was an
  /// untraceable "custom" row: nothing connected the money on the bill to the
  /// ClientPackage it created, so the package's real agreed price could not be
  /// established once a bill-level discount was involved. It is also what lets
  /// the line be price-protected like any other catalog-backed item.
  clientPackageId String?
  createdAt     DateTime     @default(now())
  basket        VisitBasket  @relation(fields: [basketId], references: [id], onDelete: Cascade)
  sessionPlan   SessionPlan? @relation(fields: [sessionPlanId], references: [id])
  clientPackage ClientPackage? @relation(fields: [clientPackageId], references: [id])
}

model ClientDebt {
  id             String        @id @default(cuid())
  clientId       String
  consultationId String?
  // The PRINCIPAL owed, in `currency`. Never re-priced and never re-denominated:
  // a $400 debt stays $400 whatever currency it is eventually paid in.
  amount         Float
  currency       String        @default("USD")
  usdToLbp       Float         @default(0)
  // USD already collected against this debt. A payment tendered in EUR/LBP is
  // converted at ITS OWN frozen rate before landing here, so the debt carries no
  // FX exposure. Outstanding = amount (in USD) - paidAmount. Guarded by a CHECK
  // (0 <= paidAmount) and only ever moved by a conditional, transactional update.
  paidAmount     Float         @default(0)
  reason         String
  source         String        @default("secretary_override")
  status         String        @default("outstanding")
  createdByName  String?
  clearedByName  String?
  clearedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consultation   Consultation? @relation(fields: [consultationId], references: [id])

  @@index([clientId])
  @@index([consultationId])
}

model BloodSample {
  id             String            @id @default(cuid())
  clientId       String
  dietitianId    String?
  dietitianName  String?
  consultationId String?           @unique
  tests          String            @default("[]")
  orderedAt      DateTime          @default(now())
  sentAt         DateTime?
  receivedAt     DateTime?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consultation   Consultation?     @relation(fields: [consultationId], references: [id])
  dietitian      User?             @relation(fields: [dietitianId], references: [id])
  files          BloodSampleFile[]

  @@index([sentAt])
  @@index([receivedAt])
}

// A file (lab-result PDF or scan) attached to a specific blood test/order. The
// bytes live inline in Postgres (`data`) — the app is Postgres-everywhere and no
// external blob store is in scope; lab results are small and size-capped in the
// upload route. List/metadata queries never select `data`, so browsing files
// stays cheap; only the download endpoint pulls the bytes. `uploadedByName` is a
// frozen snapshot of who uploaded (same pattern as BloodSample.dietitianName),
// so a later rename never rewrites the attribution.
model BloodSampleFile {
  id             String      @id @default(cuid())
  bloodSampleId  String
  filename       String
  mimeType       String
  size           Int
  data           Bytes
  uploadedById   String?
  uploadedByName String
  createdAt      DateTime    @default(now())
  bloodSample    BloodSample @relation(fields: [bloodSampleId], references: [id], onDelete: Cascade)
  uploadedBy     User?       @relation(fields: [uploadedById], references: [id])

  @@index([bloodSampleId])
}

model Expense {
  id           String   @id @default(cuid())
  title        String
  amount       Float
  currency     String   @default("USD")
  usdToLbp     Float    @default(0)
  date         DateTime @default(now())
  paidBy       String?
  method       String?
  notes        String?
  /// What this expense IS, for the P&L. "operating" (the default) is a normal
  /// running cost and is the only kind counted as an operating expense.
  /// "referral_commission" exists so a commission someone records here by hand is
  /// EXCLUDED rather than silently double-counted against the ReferralCommission
  /// ledger, which already recognized it. Referral payouts never create an
  /// Expense row at all — this is the safety net for manual entry, not the path.
  kind         String   @default("operating")
  amountEdited Boolean  @default(false)
  createdById  String?
  createdAt    DateTime @default(now())
  createdBy    User?    @relation(fields: [createdById], references: [id])
}

// ---- Machine visits ----
// A client who came ONLY to use a prepaid machine treatment: a real attendance
// record that is deliberately NOT a Consultation. It carries no clinical data
// (no measurements, notes, assessment or consultation fee) and never mints a
// visit number — `Consultation.visitNumber` stays consultation-specific. The two
// are merged for display at the view-model layer, never in the database.
//
// The row is immutable once written: a mistake is VOIDED (status flips, counters
// are restored, the row stays visible in history with who/when/why), never edited
// or deleted, matching how the rest of the app treats a recorded event.
model MachineVisit {
  id             String             @id @default(cuid())
  clientId       String
  // Actor identity, derived server-side from the session — never sent by the
  // client. The name is frozen (like Consultation.dietitianNameSnapshot) so a
  // later rename or staff deletion can't rewrite history.
  recordedById   String?
  recordedByName String
  date           DateTime           @default(now())
  note           String?
  status         String             @default("recorded")
  // The appointment this visit closed out, when one was unambiguously identified
  // (explicitly from the queue, or the single live appointment for the client
  // today). Null for a walk-in or an ambiguous match — never guessed.
  appointmentId  String?
  // Replay guard: the client sends a key per confirm, so a double-clicked button,
  // a retried POST or a browser replay resolves to the SAME visit instead of
  // consuming the sessions twice. Unique, so the race is settled by the database.
  idempotencyKey String?            @unique
  voidedAt       DateTime?
  voidedById     String?
  voidedByName   String?
  voidReason     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  client         Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recordedBy     User?              @relation("MachineVisitRecordedBy", fields: [recordedById], references: [id])
  voidedBy       User?              @relation("MachineVisitVoidedBy", fields: [voidedById], references: [id])
  appointment    Appointment?       @relation(fields: [appointmentId], references: [id])
  items          MachineVisitItem[]
  baskets        VisitBasket[]

  @@index([clientId])
  @@index([date])
}

// One machine's consumption inside a machine visit. Exactly one source per row —
// a pay-as-you-go SessionPlan or a fixed-price ClientPackage — enforced by a CHECK
// constraint in the migration (Prisma can't express it). `machine` is frozen at
// the moment of use so the history stays readable if the catalog label or the
// source row changes later.
model MachineVisitItem {
  id              String         @id @default(cuid())
  machineVisitId  String
  /// Catalog machine key, frozen at consumption — or NULL when the plan/bundle
  /// this line drew on is not tied to a machine. Null means NO MACHINE and is
  /// reported as such; it is never backfilled with an invented label (this used
  /// to fall back to the literal "Treatment", or to the bundle's name, either of
  /// which appears in a machine report as a machine that does not exist).
  machine         String?
  sessions        Int
  sessionPlanId   String?
  clientPackageId String?
  // Sessions of this line billed on the machine visit's basket (0 when prepaid
  // credit covered them). Frozen: it is what the void reverses and what the
  // reports read, never re-derived from today's plan state.
  billedSessions  Int            @default(0)
  unitPrice       Float          @default(0)
  /// Per-session clinic cost frozen when this consumption was recorded — copied
  /// from the source plan's own frozen `unitCost` (a bundle-backed line carries
  /// the bundle's per-session cost). Machine visits never bill, so this is the
  /// ONLY cost signal they leave behind. Admin-only; never serialized.
  unitCost        Float          @default(0)
  currency        String         @default("USD")
  createdAt       DateTime       @default(now())
  machineVisit    MachineVisit   @relation(fields: [machineVisitId], references: [id], onDelete: Cascade)
  // Restrict, not the default SetNull: a consumption row must never be quietly
  // orphaned from the balance it drew on. The one place a plan is deleted
  // (deleteConsultation, for a plan an abandoned visit alone created) checks for
  // machine-visit usage first and leaves the plan alone when it finds any.
  sessionPlan     SessionPlan?   @relation(fields: [sessionPlanId], references: [id], onDelete: Restrict)
  clientPackage   ClientPackage? @relation(fields: [clientPackageId], references: [id], onDelete: Restrict)

  @@index([machineVisitId])
  @@index([sessionPlanId])
  @@index([clientPackageId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String
  action      String
  entityType  String
  entityLabel String
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model Referrer {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  fee       Float    @default(0)
  /// Patients attributed to THIS referrer. Deleting a referrer nulls the link
  /// (SetNull) rather than cascading — a commission that was incurred must
  /// survive the referrer being removed from the dropdown.
  /// `Client.referrerNameSnapshot` is what keeps it attributable afterwards.
  referredClients Client[]
  commissions     ReferralCommission[]
  payouts         ReferralPayout[]
}

/// A commission the clinic OWES a referrer, and its settlement.
///
/// THE OBLIGATION IS NOT CREATED BY REGISTRATION. Attributing a patient to a
/// referrer records who sent them; it commits the clinic to nothing. The
/// liability is incurred when that patient's FIRST VISIT COMPLETES — a closed
/// consultation or a recorded machine visit, whichever comes first. A patient who
/// registers and never attends costs the clinic nothing, which is the whole point
/// of the rule.
///
/// The amount is the referrer's rate AT THAT MOMENT, frozen here. Editing the
/// referrer's fee afterwards prices future referrals only; this row never moves.
///
/// Incurring affects PROFIT (once). Paying affects CASH and creates no second
/// expense — a ReferralPayout writes no Expense and no Payment, exactly as a
/// Jessy settlement writes no Payment.
model ReferralCommission {
  id                    String    @id @default(cuid())
  /// One commission per patient, EVER — enforced by the unique constraint below
  /// rather than by convention, so two visits completing concurrently cannot both
  /// mint one. A recurring-referral model would widen this to
  /// @@unique([clientId, periodKey]); nothing else in the design would move.
  clientId              String    @unique
  referrerId            String?
  /// Durable attribution: survives the referrer being renamed or deleted.
  referrerNameSnapshot  String
  /// USD, frozen from the referrer's rate at the instant this was incurred.
  amount                Float
  /// When the clinic became liable = when the first visit completed.
  incurredAt            DateTime  @default(now())
  /// Which visit crystallized it. Exactly one of these is set.
  triggerType           String
  triggerConsultationId String?
  triggerMachineVisitId String?
  /// "incurred" -> "paid" (settled by a payout) or "void" (written off).
  status                String    @default("incurred")
  paidAt                DateTime?
  payoutId              String?
  voidReason            String?
  voidedByName          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  client                Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  referrer              Referrer? @relation(fields: [referrerId], references: [id], onDelete: SetNull)
  payout                ReferralPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([status, incurredAt])
  @@index([referrerId])
}

/// One transfer of money actually paid TO a referrer, covering one or more
/// incurred commissions. Records no Expense and no Payment: the expense was
/// already recognized when each commission was incurred, and recognizing it again
/// here would double-count it. This is a cash movement only.
model ReferralPayout {
  id                   String               @id @default(cuid())
  referrerId           String?
  referrerNameSnapshot String
  /// USD actually transferred in this payout.
  amount               Float
  reference            String?
  notes                String?
  paidAt               DateTime             @default(now())
  /// Replay guard: a double-clicked confirm resolves to the same payout.
  idempotencyKey       String?              @unique
  recordedById         String?
  recordedByName       String?
  createdAt            DateTime             @default(now())
  referrer             Referrer?            @relation(fields: [referrerId], references: [id], onDelete: SetNull)
  recordedBy           User?                @relation(fields: [recordedById], references: [id])
  commissions          ReferralCommission[]

  @@index([referrerId, paidAt])
}

model Counter {
  key   String @id
  value Int    @default(0)
}

/// Append-only history of admin changes to an exchange rate.
///
/// `Setting` remains the CURRENT value; this is the record of how it got there.
/// Separate from the generic `AuditLog` (which also gets a line for every change)
/// because a rate change is the one event whose old/new values must stay
/// machine-readable: they are financial inputs, not prose, and parsing them back
/// out of an audit label would be fragile. Same pattern the Jessy ledger uses —
/// a typed domain row plus the shared audit line.
///
/// Every field is SERVER-derived. Nothing here is accepted from the client: the
/// actor comes from the verified session, `oldValue` is read inside the same
/// transaction that writes the new one, and `changedAt` is a database default.
/// There is no update or delete path anywhere in the application.
model FxRateChange {
  id                 String   @id @default(cuid())
  /// Which rate moved: "usdToLbp" | "usdToEur" — the Setting key, so the history
  /// and the current value can never disagree about what they describe.
  rateKey            String
  /// Units of the foreign currency per 1 USD, before and after. `oldValue` is
  /// null only for the very first recorded change of a rate that was still on its
  /// built-in default (i.e. no Setting row existed yet) — a real "was unset", not
  /// a missing read.
  oldValue           Float?
  newValue           Float
  /// True when the change tripped the suspicious-delta guard and an admin
  /// explicitly confirmed it anyway. This is the marker an auditor looks for.
  suspiciousOverride Boolean  @default(false)
  /// The verified acting user. `changedById` is nullable (a user may later be
  /// deleted) but `changedByName` is frozen text, so the history survives.
  changedById        String?
  changedByName      String
  changedAt          DateTime @default(now())
  changedBy          User?    @relation(fields: [changedById], references: [id])

  /// Newest-first lookup per rate, which is how the history is always read.
  @@index([rateKey, changedAt])
  @@index([changedAt])
}
